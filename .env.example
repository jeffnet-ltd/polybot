# --- Backend / Database Config ---
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=polybot
# MongoDB local Docker:  mongodb://mongodb:27017
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=polybot
DB_NAME=polybot_database

# RunPod Serverless LLM inference (required — server will not handle LLM requests without these)
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here

# --- Voice / Speech ---
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=uksouth

# Whisper STT model size (options: tiny, base, small, medium, large, turbo)
# small recommended — larger models may exceed Fargate memory limits at 2GB task memory
WHISPER_MODEL_NAME=small

# Set to true to unload Whisper model from memory after each transcription (not recommended)
UNLOAD_VOICE_MODELS=false

# --- Frontend Config (for local development) ---
REACT_APP_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Auth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://your-domain.com/api/google/auth
# Note: must match the variable name SESSION_SECRET_KEY exactly (not SESSION_SECRET)
SESSION_SECRET_KEY=a_secure_random_string_for_session
